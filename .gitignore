__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
# Machine-local Claude Code permissions -- it holds absolute paths for
# THIS machine and a deny list tuned to this bench. A user-level git
# ignore covered it before the folder was flattened; ignoring it here
# means a fresh clone on another machine does not see it as noise.
.claude/settings.local.json
venv/
# Per-run capture outputs. The .npz is the raw record (24 MB a sweep) and the
# .csv is one run's reduced trace -- both are regenerated by re-running, and
# the trace is re-derivable from the .npz, which is the whole reason the raw
# capture is kept alongside it (Q15).
data/*.csv
data/*.log
data/*.npz
data/*.h5
data/*.bin
!data/.gitkeep
.DS_Store
